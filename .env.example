# Contact form (Resend) — copy to `.env` for local dev, and add the same
# variables in Vercel → Project → Settings → Environment Variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form enquiries are delivered (comma-separate for several)
CONTACT_TO_EMAIL=

# Optional sender. Leave empty to use Resend's test sender
# (onboarding@resend.dev), which only delivers to the email address you signed
# up to Resend with. Once you verify your own domain in Resend, set e.g.:
# CONTACT_FROM_EMAIL=Umair Ayub <hello@yourdomain.com>
CONTACT_FROM_EMAIL=
