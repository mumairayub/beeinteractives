---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

// Shown after the contact form is sent (FormSubmit redirects here via `_next`).
const metadata = {
  title: 'Thank you',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="px-4 sm:px-6 py-24 md:py-32 not-prose">
    <div class="mx-auto max-w-2xl text-center">
      <Icon name="tabler:circle-check-filled" class="mx-auto h-16 w-16 text-green-500" />
      <h1 class="mt-6 text-4xl md:text-5xl font-extrabold font-heading text-heading">Thank you!</h1>
      <p class="mt-4 text-lg text-muted">
        Your message has been sent. I'll get back to you shortly — usually within one working day.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={getPermalink('/')}
          class="rounded-xl bg-blue-700 px-8 py-4 font-bold uppercase tracking-wide text-white hover:bg-blue-600"
        >
          Back to home
        </a>
        <a
          href={getPermalink('/#results')}
          class="rounded-xl border-2 border-blue-700 px-8 py-4 font-bold uppercase tracking-wide text-blue-700 hover:bg-blue-50 dark:text-blue-300 dark:border-blue-300 dark:hover:bg-slate-800"
        >
          See my results
        </a>
      </div>
    </div>
  </section>
</Layout>
