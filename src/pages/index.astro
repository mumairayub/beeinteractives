---
import Layout from '~/layouts/PageLayout.astro';

import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Projects from '~/components/widgets/Projects.astro';
import Gallery from '~/components/widgets/Gallery.astro';
import Comparison from '~/components/widgets/Comparison.astro';
import Features3 from '~/components/widgets/Features3.astro';
import ClientLogos from '~/components/widgets/ClientLogos.astro';
import ContactSection from '~/components/widgets/ContactSection.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

/*
 * Home page: Umair Ayub's digital marketing / PPC portfolio.
 * Bio, skills, campaign numbers, screenshots and ad designs come from
 * https://umairayub.my.canva.site/ (images live in src/assets/images/portfolio/).
 */

const metadata = {
  title: 'Umair Ayub — Digital Marketing & PPC Specialist',
  description:
    'Digital marketing professional with 10+ years of experience in PPC, SEO, email marketing and lead generation. See campaign results and ad creatives.',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': organizationId,
    name: SITE?.name,
    jobTitle: 'Digital Marketing / PPC Specialist',
    url: SITE?.site,
    image: new URL(favIconSvg.src, SITE?.site).toString(),
    sameAs: [
      'https://www.linkedin.com/in/umairayub/',
      'https://www.facebook.com/mumairayub',
      'https://www.instagram.com/umair_ayubb/',
      'https://twitter.com/Umair_Ayub_',
      ...(METADATA?.twitter?.handle ? [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] : []),
    ],
  },
];

const ads = [
  { file: 'ad-01.jpg', caption: 'Arthur Lawrence — recruitment ad' },
  { file: 'ad-02.jpg', caption: 'Arthur Lawrence — recruitment ad' },
  { file: 'ad-03.png', caption: 'Arthur Lawrence — hiring campaign, Texas' },
  { file: 'ad-04.png', caption: 'ROI Staffing — hiring ad' },
  { file: 'ad-05.jpg', caption: 'ROI Staffing — career campaign' },
  { file: 'ad-06.jpg', caption: 'Xperti — hot jobs' },
  { file: 'ad-07.jpg', caption: 'Xperti — hot jobs' },
  { file: 'ad-08.jpg', caption: "OneContentPro — Women's Day offer" },
  { file: 'ad-09.jpg', caption: 'OneContentPro — Easter sale' },
  { file: 'ad-10.jpg', caption: 'OneContentPro — Halloween offer' },
  { file: 'ad-11.png', caption: 'OneContentPro — SEO services' },
  { file: 'ad-12.jpg', caption: 'Vista Book Writing — book trailers' },
  { file: 'ad-13.jpg', caption: 'Vista Book Writing — ghostwriting' },
  { file: 'ad-14.png', caption: 'UpBrainery — K-12 career exploration' },
  { file: 'ad-15.jpg', caption: 'UpBrainery — event promotion' },
  { file: 'ad-16.png', caption: 'UpBrainery — Summer 2022 offer' },
  { file: 'ad-17.jpg', caption: 'UpBrainery — summer camp' },
  { file: 'ad-18.jpg', caption: 'UpBrainery — Summer Symposium' },
  { file: 'ad-19.jpg', caption: "That's Handy — service providers" },
  { file: 'ad-20.png', caption: "That's Handy — job ad" },
  { file: 'ad-21.jpg', caption: 'Seasonal social post' },
  { file: 'ad-22.png', caption: 'Arthur Lawrence — Human Rights Day' },
  { file: 'ad-23.jpg', caption: 'Family Medicine Austin — World Yoga Day' },
  { file: 'ad-24.jpg', caption: 'UpBrainery — educational social post' },
].map(({ file, caption }) => ({
  src: `~/assets/images/portfolio/ads/${file}`,
  alt: caption,
  caption,
}));
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- 1. Hero ************************** -->

  <!--
    Agency-style hero modelled on the reference site's layout: dark background,
    eyebrow line, large uppercase headline, one primary "free audit" CTA,
    a one-line trust statement, and the portrait on the right.
  -->
  <section class="relative overflow-hidden bg-slate-950 text-white not-prose">
    <!-- background glow + grid -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-40 -left-40 h-[520px] w-[520px] rounded-full bg-blue-600/30 blur-3xl"></div>
      <div class="absolute -bottom-48 right-0 h-[560px] w-[560px] rounded-full bg-violet-600/25 blur-3xl"></div>
      <div
        class="absolute inset-0 opacity-[0.07] [background-image:linear-gradient(white_1px,transparent_1px),linear-gradient(90deg,white_1px,transparent_1px)] [background-size:56px_56px]"
      >
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-16 md:py-24 grid gap-12 lg:grid-cols-2 items-center">
      <!-- Left: copy -->
      <div class="text-center lg:text-left">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs sm:text-sm font-semibold uppercase tracking-widest text-blue-300"
        >
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Digital Marketing / Pay Per Click (PPC)
        </p>

        <h1
          class="mt-6 font-heading font-extrabold uppercase leading-[0.95] tracking-tight text-4xl sm:text-6xl xl:text-7xl"
        >
          Stop wasting<br />
          ad spend.<br />
          <span class="bg-gradient-to-r from-blue-400 to-violet-400 bg-clip-text text-transparent"
            >Start getting leads.</span
          >
        </h1>

        <p class="mt-6 max-w-xl mx-auto lg:mx-0 text-lg text-slate-300">
          I'm <span class="font-semibold text-white">Umair Ayub</span> — a digital marketer with 10+ years running Google,
          Meta and Microsoft Ads for healthcare, legal, education and recruitment brands. You work with me directly, from
          strategy to reporting.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
          <a
            href="#contact"
            class="inline-flex items-center gap-2 rounded-full bg-blue-600 px-8 py-4 text-base font-bold uppercase tracking-wide text-white shadow-lg shadow-blue-600/30 transition hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
          >
            Get a free PPC audit
            <Icon name="tabler:arrow-right" class="h-5 w-5" />
          </a>
          <a
            href="#results"
            class="inline-flex items-center gap-2 px-4 py-4 text-base font-semibold text-slate-200 hover:text-white"
          >
            See my results
            <Icon name="tabler:chevron-down" class="h-5 w-5" />
          </a>
        </div>

        <!-- trust line -->
        <div
          class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 justify-center lg:justify-start text-sm text-slate-400"
        >
          <span class="inline-flex items-center gap-2">
            <Icon name="tabler:circle-check-filled" class="h-5 w-5 text-emerald-400" />
            10+ years experience
          </span>
          <span class="inline-flex items-center gap-2">
            <Icon name="tabler:brand-google" class="h-5 w-5 text-slate-200" />
            Google Ads
          </span>
          <span class="inline-flex items-center gap-2">
            <Icon name="tabler:brand-meta" class="h-5 w-5 text-slate-200" />
            Meta Ads
          </span>
          <span class="inline-flex items-center gap-2">
            <Icon name="tabler:brand-windows" class="h-5 w-5 text-slate-200" />
            Microsoft Ads
          </span>
        </div>
      </div>

      <!-- Right: paid ads marketing graphic -->
      <div class="relative mx-auto w-full max-w-2xl">
        <div
          class="absolute -inset-3 rounded-[2rem] bg-gradient-to-br from-blue-500 via-blue-600 to-violet-600 opacity-50 blur-xl"
          aria-hidden="true"
        >
        </div>
        <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-slate-900 shadow-2xl">
          <Image
            src="~/assets/images/portfolio/paid-ads-marketing.webp"
            alt="Paid ads marketing: Google, Facebook, Instagram and YouTube ads with growth charts"
            width={1024}
            height={683}
            loading="eager"
            fetchpriority="high"
            class="w-full h-auto"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Clients *********************** -->

  <ClientLogos />

  <!-- 3. Stats ************************* -->

  <Stats
    countUp
    stats={[
      { amount: '10+', title: 'Years of experience' },
      { amount: '$134K', title: 'Spend managed in one Google Ads account' },
      { amount: '41.5K', title: 'Conversions from that account' },
      { amount: '3.67M', title: 'Impressions on a single campaign set' },
    ]}
  />

  <!-- 4. About ************************* -->

  <Content
    id="about"
    tagline="About me"
    title="Result-oriented digital marketer"
    image={{ src: '~/assets/images/portfolio/umair-ayub-about.jpg', alt: 'Portrait of Umair Ayub', aspect: '3/4' }}
    classes={{ image: 'max-w-xs lg:max-w-sm' }}
    items={[
      { title: "Master's degree in Marketing", icon: 'tabler:school' },
      { title: 'Almost 10+ years of hands-on experience', icon: 'tabler:briefcase' },
      { title: 'Proven leadership & team management', icon: 'tabler:users' },
      { title: 'Strong communication & problem-solving skills', icon: 'tabler:bulb' },
    ]}
  >
    <Fragment slot="content">
      A seasoned digital marketing professional with a master's degree in Marketing and almost 10+ years of sound
      working experience. A result-oriented self-starter, now looking to make a significant contribution in a Senior
      Digital Marketing Specialist role toward the success of a growing organization.
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- 5. Skills ************************ -->

  <Features
    id="skills"
    tagline="Skills"
    title="What I do"
    columns={4}
    items={[
      {
        title: 'PPC',
        description: 'Google Ads, Microsoft Ads and Meta Ads — search, display, call and lead campaigns.',
        icon: 'tabler:click',
      },
      {
        title: 'SEO',
        description: 'Keyword research, on-page optimisation and content that ranks.',
        icon: 'tabler:search',
      },
      {
        title: 'Email',
        description: 'Email campaigns and automation with tools like Mailchimp.',
        icon: 'tabler:mail',
      },
      {
        title: 'Lead Generation',
        description: 'Campaigns, landing pages and tracking built to turn clicks into enquiries.',
        icon: 'tabler:target-arrow',
      },
    ]}
  />

  <!-- 6. Campaign results ************** -->

  <Projects
    id="results"
    tagline="Results"
    title="Campaign results"
    subtitle="Screenshots from live Google Ads accounts I have managed."
    items={[
      {
        title: 'Family Medicine Austin',
        description:
          'Search, call and display campaigns for a healthcare clinic. The top campaign spent $64,289 for 23,410 clicks at a 4.00% CTR.',
        image: {
          src: '~/assets/images/portfolio/results/family-medicine-austin-campaigns.png',
          alt: 'Google Ads campaign summary for Family Medicine Austin',
        },
        tags: ['Healthcare', 'Google Ads'],
        result: 'Up to 10.05% CTR',
      },
      {
        title: 'Ghosheh Law Firm',
        description:
          'Search campaigns for accident reports, car crash reports and immigration services in English and Spanish.',
        image: {
          src: '~/assets/images/portfolio/results/ghosheh-law-firm-campaigns.png',
          alt: 'Google Ads campaign summary for Ghosheh Law Firm',
        },
        tags: ['Legal', 'Search'],
        result: '8.68% CTR on Car Crash Report',
      },
      {
        title: 'Account overview: $134K spend',
        description: 'A large Google Ads account: $134K spent, 48.6K clicks at a $2.75 average CPC.',
        image: {
          src: '~/assets/images/portfolio/results/account-overview-134k.png',
          alt: 'Google Ads overview showing $134K cost, 48.6K clicks and 41.5K conversions',
        },
        tags: ['Google Ads', 'Scale'],
        result: '41.5K conversions',
      },
      {
        title: 'UpBrainery',
        description:
          'Traffic and lead campaigns for an education platform: free tutoring sessions, educational kits and summer camps.',
        image: {
          src: '~/assets/images/portfolio/results/upbrainery-campaigns.png',
          alt: 'Google Ads campaign summary for UpBrainery',
        },
        tags: ['Education', 'Google Ads'],
        result: '7.65% CTR on Free Tutoring Sessions',
      },
      {
        title: 'OneDesignPro',
        description: 'Search campaigns for logo design and website design and development services.',
        image: {
          src: '~/assets/images/portfolio/results/onedesignpro-campaigns.png',
          alt: 'Google Ads campaign summary for OneDesignPro',
        },
        tags: ['Agency', 'Search'],
        result: '6.52% CTR on Logo Search',
      },
      {
        title: 'Account overview: 3.67M impressions',
        description: '$28.3K spent, generating 3.67M impressions and 10.9K clicks.',
        image: {
          src: '~/assets/images/portfolio/results/account-overview-3-67m.png',
          alt: 'Google Ads overview showing $28.3K cost, 3.67M impressions, 10.9K clicks and 990 conversions',
        },
        tags: ['Google Ads', 'Awareness'],
        result: '990 conversions',
      },
    ]}
    callToAction={{ text: 'Get in touch', href: '#contact', variant: 'primary' }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Projects>

  <!-- 7. Ad creatives gallery ********** -->

  <Gallery
    id="portfolio"
    tagline="Portfolio"
    title="Ad creatives & social media"
    subtitle="A selection of ads and social posts from my campaigns. Click any image to enlarge it."
    columns={4}
    images={ads}
  />

  <!-- 8. Comparison ******************** -->

  <Comparison
    tagline="Why me"
    title="How working with me compares"
    mode="versus"
    columns={[
      { title: 'Umair Ayub', highlight: true },
      { title: 'Typical agency' },
      { title: 'Generalist freelancer' },
    ]}
    rows={[
      { label: '10+ years of digital marketing experience', values: [true, 'Varies', 'Varies'] },
      { label: 'Direct contact with the person doing the work', values: [true, false, true] },
      { label: 'PPC, SEO, email and lead gen under one roof', values: [true, true, false] },
      { label: 'Experience across healthcare, legal, education and recruitment', values: [true, 'Varies', false] },
      { label: 'Full tracking & reporting setup', values: [true, true, false] },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Comparison>

  <!-- 9. Services ********************** -->

  <Features3
    id="services"
    tagline="Services"
    title="How I can help"
    columns={3}
    items={[
      {
        title: 'Google Ads',
        description: 'Search, display and call campaigns built around keywords that bring in customers.',
        icon: 'tabler:brand-google',
      },
      {
        title: 'Meta Ads',
        description: 'Facebook and Instagram campaigns with eye-catching creatives and audience targeting.',
        icon: 'tabler:brand-meta',
      },
      {
        title: 'Microsoft Ads',
        description: 'Reach extra high-intent searchers on Bing, often at a lower cost per click.',
        icon: 'tabler:brand-windows',
      },
      {
        title: 'SEO',
        description: 'Improve your organic rankings with keyword research and on-page optimisation.',
        icon: 'tabler:world-search',
      },
      {
        title: 'Email marketing',
        description: 'Campaigns and newsletters that keep your audience engaged and coming back.',
        icon: 'tabler:mail-forward',
      },
      {
        title: 'Lead generation',
        description: 'End-to-end funnels: ads, landing pages, forms and conversion tracking.',
        icon: 'tabler:filter',
      },
    ]}
  />

  <!-- 10. Contact ********************** -->

  <ContactSection />

  <!-- 11. FAQ ************************** -->

  <FAQs
    id="faq"
    tagline="FAQ"
    title="Frequently asked questions"
    schema
    items={[
      {
        title: 'Which industries have you worked in?',
        description:
          'Healthcare, legal, education, recruitment and staffing, publishing, and digital agencies, among others.',
      },
      {
        title: 'Which ad platforms do you manage?',
        description: 'Mainly Google Ads, plus Microsoft Ads and Meta (Facebook and Instagram) Ads.',
      },
      {
        title: 'Do you also design the ads?',
        description: 'Yes. I create ad creatives and social media posts as well as running the campaigns.',
      },
      {
        title: 'Do I keep ownership of my ad accounts?',
        description: 'Yes. Your ad accounts, data and tracking always stay in your name.',
      },
      {
        title: 'How do we get started?',
        description:
          'Send a message through the form above or on LinkedIn, and we will set up a short call about your goals.',
      },
    ]}
  />
</Layout>
