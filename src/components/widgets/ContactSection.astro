---
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  /** Heading on the form card. */
  formTitle?: string;
}
const { formTitle = 'Get Your Free Strategy Consultation' } = Astro.props;

/*
 * Submissions go to the /api/contact server route, which emails them via
 * Resend (see src/pages/api/contact.ts). The destination address lives in the
 * CONTACT_TO_EMAIL environment variable, so it never appears in the page.
 */
const formAction = '/api/contact';
const pagePath = Astro.url.pathname;
---

<section id="contact" class="bg-slate-100 dark:bg-slate-950 px-4 sm:px-6 py-16 md:py-24 not-prose scroll-mt-20">
  <div
    class="mx-auto max-w-7xl rounded-[2.5rem] bg-blue-700 px-6 py-12 sm:px-12 md:py-16 lg:px-16 grid gap-12 lg:grid-cols-2 lg:items-center"
  >
    <!-- Left: pitch -->
    <div class="text-white">
      <h2 class="font-heading font-extrabold uppercase leading-[0.95] tracking-tight text-4xl sm:text-5xl xl:text-6xl">
        Let's partner<br />
        to reach<br />
        your business goals
      </h2>
      <p class="mt-8 max-w-xl text-lg text-blue-100">
        Growth shouldn't be guesswork. Tell me about your business, goals and budget, and I'll show you how PPC, SEO,
        email and lead generation can work together to bring you real, measurable results.
      </p>
      <ul class="mt-10 space-y-4 text-lg">
        {
          [
            'A quick intro call or email',
            'Marketing plan designed to achieve your goals',
            'A detailed personalized PPC audit upon request',
          ].map((point) => (
            <li class="flex items-start gap-3">
              <Icon name="tabler:square-check-filled" class="mt-0.5 h-6 w-6 shrink-0 text-green-400" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Right: form card -->
    <div class="rounded-3xl bg-white p-6 sm:p-10 shadow-2xl dark:bg-slate-900">
      <h3 class="text-2xl font-bold text-slate-900 dark:text-white">{formTitle}</h3>
      <form class="mt-6 space-y-6" method="post" action={formAction} data-contact-form>
        <!-- Context for the email -->
        <input type="hidden" name="topic" value={formTitle} />
        <input type="hidden" name="page" value={pagePath} />
        <!-- Spam trap: real visitors never see or fill this -->
        <input
          type="text"
          name="_honey"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute left-[-9999px] h-px w-px opacity-0"
        />
        <div>
          <label for="contact-name" class="sr-only">First name</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="given-name"
            required
            placeholder="First Name *"
            class="w-full border-0 border-b border-slate-400 bg-transparent px-1 py-3 text-slate-900 placeholder:text-slate-500 focus:border-blue-700 focus:ring-0 dark:text-white dark:border-slate-600"
          />
        </div>
        <div>
          <label for="contact-email" class="sr-only">Work email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="Work Email *"
            class="w-full border-0 border-b border-slate-400 bg-transparent px-1 py-3 text-slate-900 placeholder:text-slate-500 focus:border-blue-700 focus:ring-0 dark:text-white dark:border-slate-600"
          />
        </div>
        <div>
          <label for="contact-message" class="sr-only">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            placeholder="Message"
            class="w-full resize-none border-0 border-b border-slate-400 bg-transparent px-1 py-3 text-slate-900 placeholder:text-slate-500 focus:border-blue-700 focus:ring-0 dark:text-white dark:border-slate-600"
          ></textarea>
        </div>
        <label class="flex items-start gap-3 text-sm text-slate-500 dark:text-slate-400">
          <input
            type="checkbox"
            name="consent"
            required
            class="mt-0.5 h-5 w-5 shrink-0 rounded border-slate-300 text-blue-700 focus:ring-blue-700"
          />
          <span>
            By clicking the button, I agree to be contacted about my enquiry and to the{' '}
            <a href={getPermalink('/privacy')} class="underline hover:text-blue-700">privacy policy</a>.
          </span>
        </label>
        <button
          type="submit"
          data-submit
          class="rounded-xl bg-yellow-400 px-16 py-4 text-base font-bold uppercase tracking-wide text-slate-900 transition hover:bg-yellow-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400 disabled:cursor-wait disabled:opacity-70"
        >
          Send
        </button>
        <p data-status role="status" aria-live="polite" class="hidden rounded-lg px-4 py-3 text-sm font-medium"></p>
      </form>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement: send in the background and show the result in the
  // card. Without JavaScript the form still posts normally and the server
  // redirects to /thank-you.
  const STATUS_OK = 'block bg-green-50 text-green-800 dark:bg-green-900/40 dark:text-green-200';
  const STATUS_ERR = 'block bg-red-50 text-red-800 dark:bg-red-900/40 dark:text-red-200';

  const setup = () => {
    document.querySelectorAll<HTMLFormElement>('form[data-contact-form]').forEach((form) => {
      if (form.dataset.enhanced) return;
      form.dataset.enhanced = 'true';
      const button = form.querySelector<HTMLButtonElement>('[data-submit]');
      const status = form.querySelector<HTMLElement>('[data-status]');
      const show = (ok: boolean, text: string) => {
        if (!status) return;
        status.className = `rounded-lg px-4 py-3 text-sm font-medium ${ok ? STATUS_OK : STATUS_ERR}`;
        status.textContent = text;
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (button) {
          button.disabled = true;
          button.textContent = 'Sending…';
        }
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          const data = (await res.json().catch(() => ({}))) as { ok?: boolean; message?: string };
          if (res.ok && data.ok) {
            form.reset();
            show(true, "Thank you! Your message has been sent — I'll get back to you shortly.");
          } else {
            show(false, data.message || 'Sorry, something went wrong. Please try again.');
          }
        } catch {
          show(false, 'Network error — please check your connection and try again.');
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = 'Send';
          }
        }
      });
    });
  };
  setup();
  document.addEventListener('astro:page-load', setup);
</script>
