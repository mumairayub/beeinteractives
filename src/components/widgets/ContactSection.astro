---
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  /** Heading on the form card. */
  formTitle?: string;
}
const { formTitle = 'Get Your Free Strategy Consultation' } = Astro.props;

/*
 * Submissions are emailed via FormSubmit (https://formsubmit.co) — no account
 * needed. The first submission triggers an activation email to this address;
 * after clicking "Activate", every submission is forwarded.
 * Tip: after activation FormSubmit offers a random alias you can use here
 * instead of the plain address, so the address isn't visible in the page source.
 */
const FORM_EMAIL = 'umair.numl@gmail.com';
const formAction = `https://formsubmit.co/${FORM_EMAIL}`;
const pagePath = Astro.url.pathname;
---

<section id="contact" class="bg-slate-100 dark:bg-slate-950 px-4 sm:px-6 py-16 md:py-24 not-prose scroll-mt-20">
  <div
    class="mx-auto max-w-7xl rounded-[2.5rem] bg-blue-700 px-6 py-12 sm:px-12 md:py-16 lg:px-16 grid gap-12 lg:grid-cols-2 lg:items-center"
  >
    <!-- Left: pitch -->
    <div class="text-white">
      <h2 class="font-heading font-extrabold uppercase leading-[0.95] tracking-tight text-4xl sm:text-5xl xl:text-6xl">
        Let's partner<br />
        to reach<br />
        your business goals
      </h2>
      <p class="mt-8 max-w-xl text-lg text-blue-100">
        Growth shouldn't be guesswork. Tell me about your business, goals and budget, and I'll show you how PPC, SEO,
        email and lead generation can work together to bring you real, measurable results.
      </p>
      <ul class="mt-10 space-y-4 text-lg">
        {
          [
            'A quick intro call or email',
            'Marketing plan designed to achieve your goals',
            'A detailed personalized PPC audit upon request',
          ].map((point) => (
            <li class="flex items-start gap-3">
              <Icon name="tabler:square-check-filled" class="mt-0.5 h-6 w-6 shrink-0 text-green-400" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Right: form card -->
    <div class="rounded-3xl bg-white p-6 sm:p-10 shadow-2xl dark:bg-slate-900">
      <h3 class="text-2xl font-bold text-slate-900 dark:text-white">{formTitle}</h3>
      <form class="mt-6 space-y-6" method="post" action={formAction} data-contact-form>
        <!-- FormSubmit settings -->
        <input type="hidden" name="_subject" value={`New enquiry from your website (${formTitle})`} />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="page" value={pagePath} />
        <input type="hidden" name="_next" value="" data-next />
        <!-- Spam trap: real visitors never see or fill this -->
        <input
          type="text"
          name="_honey"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute -left-[9999px] h-px w-px opacity-0"
        />
        <div>
          <label for="contact-name" class="sr-only">First name</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="given-name"
            required
            placeholder="First Name *"
            class="w-full border-0 border-b border-slate-400 bg-transparent px-1 py-3 text-slate-900 placeholder:text-slate-500 focus:border-blue-700 focus:ring-0 dark:text-white dark:border-slate-600"
          />
        </div>
        <div>
          <label for="contact-email" class="sr-only">Work email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="Work Email *"
            class="w-full border-0 border-b border-slate-400 bg-transparent px-1 py-3 text-slate-900 placeholder:text-slate-500 focus:border-blue-700 focus:ring-0 dark:text-white dark:border-slate-600"
          />
        </div>
        <div>
          <label for="contact-message" class="sr-only">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            placeholder="Message"
            class="w-full resize-none border-0 border-b border-slate-400 bg-transparent px-1 py-3 text-slate-900 placeholder:text-slate-500 focus:border-blue-700 focus:ring-0 dark:text-white dark:border-slate-600"
          ></textarea>
        </div>
        <label class="flex items-start gap-3 text-sm text-slate-500 dark:text-slate-400">
          <input
            type="checkbox"
            name="consent"
            required
            class="mt-0.5 h-5 w-5 shrink-0 rounded border-slate-300 text-blue-700 focus:ring-blue-700"
          />
          <span>
            By clicking the button, I agree to be contacted about my enquiry and to the{' '}
            <a href={getPermalink('/privacy')} class="underline hover:text-blue-700">privacy policy</a>.
          </span>
        </label>
        <button
          type="submit"
          class="rounded-xl bg-yellow-400 px-16 py-4 text-base font-bold uppercase tracking-wide text-slate-900 transition hover:bg-yellow-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-400"
        >
          Send
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  // After sending, FormSubmit redirects to `_next`; it needs an absolute URL,
  // so it's filled in from the current site address at runtime.
  const setNext = () => {
    document.querySelectorAll<HTMLInputElement>('[data-contact-form] [data-next]').forEach((input) => {
      input.value = `${window.location.origin}/thank-you`;
    });
  };
  setNext();
  document.addEventListener('astro:page-load', setNext);
</script>
